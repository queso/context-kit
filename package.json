{
  "name": "context-kit",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "validate": "bun run typecheck && bun run check && bun test",
    "test:e2e": "flowspec run"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reactive-swr": "github:queso/reactiveSWR",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@happy-dom/global-registrator": "20.14.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "~1.3.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "flowspec": "^0.3.0",
    "happy-dom": "20.14.1",
    "pino-pretty": "^13.1.3",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ],
  "packageManager": "bun@1.3.11"
}
