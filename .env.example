# Database
DATABASE_URL=postgresql://context_kit:context_kit@localhost:5432/context_kit

# Logging
# Valid values: debug, info, warn, error (default: info)
LOG_LEVEL=info

# SEO
# Canonical site URL for sitemap, robots.txt, and Open Graph metadata (default: http://localhost:3000)
SITE_URL=http://localhost:3000

# CORS
# Allowed origin for CORS requests (default: empty string, same-origin only)
# Example: https://app.example.com
CORS_ORIGIN=

# Rate Limiting
# Maximum requests per minute per IP (default: 60)
RATE_LIMIT_RPM=60
