# Database connection. Two schemes are supported:
#   sqlite:    a local file (default). Relative paths resolve from the project root.
#              In-memory: sqlite::memory:
#   postgres:  PostgreSQL (postgresql:// also works)
#              e.g. DATABASE_URL=postgres://context_kit:context_kit@localhost:5432/context_kit
#              For a remote server, require verified TLS: append ?sslmode=verify-full
#              (the local Docker Compose Postgres has no TLS, so omit it there).
# Optional outside production (defaults to the value below); required in production.
DATABASE_URL=sqlite:./data/dev.sqlite

# Pino log level. Valid values: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Canonical site URL used for sitemap, robots.txt, and Open Graph metadata (default: http://localhost:3000)
SITE_URL=http://localhost:3000

# Allowed origin for CORS requests. Set to "*" for any origin, or a specific URL.
# Leave empty for same-origin only (default: "")
CORS_ORIGIN=

# Max API requests per minute per IP address (default: 60)
RATE_LIMIT_RPM=60
