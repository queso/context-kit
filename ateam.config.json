{
  "packageManager": "pnpm",
  "checks": {
    "lint": "pnpm check",
    "unit": "pnpm test",
    "typecheck": "pnpm typecheck",
    "validate": "pnpm validate",
    "e2e": "pnpm test:e2e"
  },
  "precheck": ["validate"],
  "postcheck": ["validate", "e2e"],
  "devServer": {
    "url": "http://localhost:3000",
    "start": "pnpm dev",
    "restart": "docker compose restart app",
    "managed": false
  }
}
