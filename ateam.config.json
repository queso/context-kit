{
  "packageManager": "bun",
  "checks": {
    "lint": "bun run check",
    "unit": "bun test",
    "typecheck": "bun run typecheck",
    "validate": "bun run validate",
    "e2e": "bun run test:e2e"
  },
  "precheck": ["validate"],
  "postcheck": ["validate", "e2e"],
  "devServer": {
    "url": "http://localhost:3000",
    "start": "bun run dev",
    "restart": "docker compose restart app",
    "managed": false
  }
}
